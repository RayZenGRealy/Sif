# Cloud model used by the SIF backend gateway
GEMINI_API_KEY=
SIF_GEMINI_MODEL=gemini-3-flash-preview

# OpenAI-compatible local model server (Ollama, LM Studio, vLLM, etc.)
SIF_LOCAL_BASE_URL=http://127.0.0.1:11434
SIF_LOCAL_MODEL=
SIF_LOCAL_API_KEY=

# Gateway
SIF_GATEWAY_HOST=127.0.0.1
SIF_GATEWAY_PORT=8787
SIF_CORS_ORIGIN=http://localhost:3000
SIF_MAX_BODY_BYTES=26214400
