# Set true to forbid all cloud fallbacks
SIF_OFFLINE_ONLY=false

# Cloud model used by the SIF backend gateway
GEMINI_API_KEY=
SIF_GEMINI_MODEL=gemini-3-flash-preview

# OpenAI-compatible local model server (Ollama, LM Studio, vLLM, etc.)
SIF_LOCAL_BASE_URL=http://127.0.0.1:11434
SIF_LOCAL_MODEL=
SIF_LOCAL_API_KEY=

# Gateway
SIF_GATEWAY_HOST=127.0.0.1
SIF_GATEWAY_PORT=8787
SIF_CORS_ORIGIN=http://localhost:3000
SIF_MAX_BODY_BYTES=26214400

# Local speech-to-text (OpenAI-compatible /v1/audio/transcriptions)
SIF_STT_BASE_URL=http://127.0.0.1:8000
SIF_STT_MODEL=
SIF_STT_LANGUAGE=ru
SIF_STT_API_KEY=

# Local text-to-speech (OpenAI-compatible /v1/audio/speech)
SIF_TTS_BASE_URL=http://127.0.0.1:8880
SIF_TTS_MODEL=
SIF_TTS_VOICE=default
SIF_TTS_FORMAT=wav
SIF_TTS_API_KEY=

# Local knowledge service
SIF_KNOWLEDGE_PORT=8788
SIF_DATA_DIR=.sif-data
SIF_MEMORY_TOP_K=6
SIF_MAX_DOCUMENT_BYTES=15728640

# Semantic memory / local embeddings (OpenAI-compatible /v1/embeddings)
# If BASE_URL is empty, SIF_LOCAL_BASE_URL is used.
SIF_EMBEDDING_BASE_URL=
SIF_EMBEDDING_MODEL=
SIF_EMBEDDING_API_KEY=
SIF_EMBEDDING_BATCH_SIZE=16

# Audio / Video Memory
# Knowledge Service accepts larger base64 uploads than the chat gateway.
SIF_KNOWLEDGE_MAX_BODY_BYTES=167772160
SIF_MAX_MEDIA_BYTES=104857600
SIF_FFMPEG_PATH=ffmpeg
SIF_VIDEO_FRAME_INTERVAL_SECONDS=15
SIF_VIDEO_MAX_FRAMES=12

# Optional local vision model (OpenAI-compatible /v1/chat/completions with image_url)
# If BASE_URL is empty, SIF_LOCAL_BASE_URL is used.
SIF_VISION_BASE_URL=
SIF_VISION_MODEL=
SIF_VISION_API_KEY=
